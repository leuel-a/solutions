# EditorConfig helps maintain consistent coding styles across editors/IDEs
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.java]
indent_size = 4
max_line_length = 80

[*.{yml,yaml}]
indent_size = 2

[*.{xml,pom}]
indent_size = 4

[pom.xml]
indent_size = 4

[*.{json,md}]
indent_size = 4

[Makefile]
indent_style = tab
